# Event Smart Frontend Environment Variables

# Backend API Base URL (Modular Monolith)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# AI Microservice Base URL (FastAPI) - accessed via backend or direct local testing
VITE_AI_BASE_URL=http://localhost:8000/internal/v1

# Realtime Gateway Base URL (Socket.IO)
VITE_SOCKET_URL=http://localhost:5000

# Mock Fallback Mode: When true, API services gracefully fall back to local mock data if the backend is unreachable
VITE_ENABLE_MOCK_FALLBACK=true

# Show Prototype Navigation Bar (set to false in production)
VITE_SHOW_PROTOTYPE_BAR=true
